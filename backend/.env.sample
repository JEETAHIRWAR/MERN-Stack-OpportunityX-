PORT=8000
NODE_ENV=development
MONGODB_URI=example
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
ADMIN_REGISTRATION_CODE=
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Legacy migration only. Prefer a staging URI for the dry run.
MIGRATION_MONGODB_URI=
LEGACY_JOB_OWNER_ID=

# Per-IP rate limits. Memory storage is suitable for one server instance;
# use a shared store before horizontally scaling the API.
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PASSWORD_WINDOW_MINUTES=60
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_APPLICATION_WINDOW_MINUTES=15
RATE_LIMIT_APPLICATION_MAX=20
RATE_LIMIT_VIEW_WINDOW_MINUTES=5
RATE_LIMIT_VIEW_MAX=120
RATE_LIMIT_AI_WINDOW_MINUTES=15
RATE_LIMIT_AI_MAX=20

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# AI provider. Both values are required before AI routes become available.
OPENAI_API_KEY=
OPENAI_MODEL=

# Managed uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
